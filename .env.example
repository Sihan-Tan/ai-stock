# =============================================================================
# 刻度 Desk 环境变量示例（复制为 .env 后按需填写）
# 布尔值请用 true / false；设置页写入 .env 时也使用该格式
# =============================================================================

# ----- 数据库 -----
# PostgreSQL / MySQL 连接串（SQLAlchemy URL）
DATABASE_URL=postgresql+psycopg://desk:desk@localhost:5432/desk
# DATABASE_URL=mysql+pymysql://desk:desk@localhost:3306/desk
# 数据库连接超时（秒），避免启动探测长时间卡住
DB_CONNECT_TIMEOUT=3

# ----- 交易模式与实盘闸门 -----
# 交易模式：paper=纸交易 | live=实盘
TRADE_MODE=paper
# 实盘是否自动成交；false=进入审批队列，需人工确认
AUTO_EXECUTE_LIVE=false
# 确认已理解自动实盘风险；须与 AUTO_EXECUTE_LIVE 同时为 true 才可自动真单
I_UNDERSTAND_AUTO_LIVE=false

# ----- 机器学习 -----
# ML 引擎：lightgbm | xgboost
ML_ENGINE=lightgbm

# ----- 大模型（投研对话 / 投研精选） -----
# 提供商：openai | deepseek | chatgpt
LLM_PROVIDER=deepseek
# API Key（必填才能跑投研聊天与投研精选）
LLM_API_KEY=
# OpenAI 兼容接口 Base URL
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名（如 deepseek-v4-flash / deepseek-v4-pro）
LLM_MODEL=deepseek-v4-flash

# ----- 知识库检索 / Embedding -----
# 检索模式：keyword（关键词）| vector（向量）| hybrid（混合）
# 无可用 Embedding 凭证时仅 keyword；hybrid 会降级为 keyword
# KNOWLEDGE_RETRIEVAL=keyword
# Embedding API Key；空则回退 LLM_API_KEY（但 DeepSeek Chat 主机不会当 embedding 用）
# EMBEDDING_API_KEY=
# Embedding Base URL（须支持 OpenAI 兼容 /embeddings）；空则回退 LLM_BASE_URL
# DeepSeek（api.deepseek.com）无 embeddings，请填 OpenAI / 硅基流动等，例如：
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_BASE_URL=
# Embedding 模型名（如 text-embedding-3-small）；空则有可用凭证时默认 text-embedding-3-small
# EMBEDDING_MODEL=

# ----- 飞书告警 -----
# 飞书自定义机器人 Webhook 完整 URL；空=不推送
FEISHU_WEBHOOK_URL=
# 飞书机器人签名密钥（若机器人开启了签名校验则必填）
FEISHU_SIGN_SECRET=
# 飞书告警总开关；false=自动告警静音（测试推送仍可强制发送）
FEISHU_ALERT_ENABLED=true
# 允许自动推送的类别（逗号分隔）：morning,closing,paper,research,risk 等；默认不含 risk
FEISHU_ALERT_CATEGORIES=morning,closing,paper,research

# ----- miniQMT -----
# miniQMT userdata_mini 目录路径
QMT_USERDATA_PATH=C:\QMT\userdata_mini
# QMT 资金账号；空则无法发真单
QMT_ACCOUNT_ID=
# true=强制 Mock 不发真单（推荐默认）；false=双开关开启且账号齐全时可发真单
QMT_FORCE_MOCK=true

# ----- 纸交易账户 -----
# 纸交易初始资金（元）
PAPER_INITIAL_CASH=1000000
# 纸交易手动下单缺省策略 ID（生命周期闸门用）
PAPER_DEFAULT_STRATEGY_ID=ma_cross
# 是否启用 Paper Runner 定时扫描自选
PAPER_RUNNER_ENABLED=false
# Paper Runner 使用的策略 ID
PAPER_RUNNER_STRATEGY_ID=ma_cross
# 连续竞价时段扫描间隔（分钟，建议 ≥5）
PAPER_RUNNER_INTERVAL_MINUTES=30

# ----- 投研精选（早盘 / 尾盘 LLM 二次筛选） -----
# 精选输出条数 TopN（1–20）
RESEARCH_REFINE_TOP_N=5
# 置信度门槛（0–100）；低于此值的候选丢弃
RESEARCH_REFINE_MIN_CONFIDENCE=70
# 送入 LLM 的候选上限（1–50）；按原选拔 score 截断
RESEARCH_REFINE_MAX_CANDIDATES=15
# true=早盘/尾盘选拔成功后自动跑精选；false=仅手动触发
RESEARCH_REFINE_AUTO=false
# 日终 LLM 复盘自动开关；交易日 15:45（北京）生成；当日已有笔记则跳过
# REVIEW_AUTO=false
# POSITIONS_ADVICE_ENABLED=true
# POSITIONS_ADVICE_MODE=llm
# POSITIONS_ADVICE_SOURCE=live
# 每批送入 LLM 的候选数（1–10）；预取事实后单次无工具打分
RESEARCH_REFINE_BATCH_SIZE=4
# 并行批次数上限（1–4）
RESEARCH_REFINE_PARALLEL=2

# ----- 投研技能与联网搜索 -----
# 本地 skills 目录（相对仓库根）
SKILLS_DIR=skills
# Tavily 搜索 API Key；空则投研 web_search 工具不可用
TAVILY_API_KEY=

# ----- 回测费用（A 股近似） -----
# 买入佣金率（成交额比例，不含印花税）
BACKTEST_BUY_COMMISSION=0.00025
# 卖出佣金率（成交额比例，不含印花税）
BACKTEST_SELL_COMMISSION=0.00025
# 印花税税率（仅卖出）
BACKTEST_STAMP_DUTY=0.001
# 单笔佣金最低收费（元）；印花税不参与保底
BACKTEST_MIN_COMMISSION=5
# 回测滑点（成交价比例）
BACKTEST_SLIPPAGE=0.001

# ----- 下单风控与实盘闸门 -----
# 单笔最大仓位：占总权益百分比（0–100）；与单笔最大金额取较小者
RISK_MAX_ORDER_POSITION_PCT=10
# 单笔最大金额（元）
RISK_MAX_ORDER_NOTIONAL=50000
# 单日累计最大成交金额（元）
RISK_MAX_DAILY_NOTIONAL=200000
# 最多持仓股票只数；0=不限制
RISK_MAX_POSITIONS=4
# 实盘 ARM：false 时拒绝 live 下单
RISK_ARMED=false
# Kill Switch：true 时拒绝一切 live 下单
RISK_KILL_SWITCH=false
# 实盘白名单，逗号分隔代码；空=不限制标的
RISK_WHITELIST=

# ----- 行情同步 -----
# 日线历史下载起始日（YYYY-MM-DD）；显式设置时优先于 YAML
MARKET_DAILY_START=2018-01-01
# 增量同步回溯天数
MARKET_INCREMENTAL_DAYS=3
# 行情同步批大小（每批标的数）
MARKET_BATCH_SIZE=100
# 行情同步 YAML 配置路径
MARKET_SYNC_YAML=configs/market/sync.yaml
# 指数列表 YAML 配置路径
MARKET_INDICES_YAML=configs/market/indices.yaml
# 是否启用行情定时调度任务
MARKET_SCHEDULER_ENABLED=true
